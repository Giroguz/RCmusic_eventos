PORT=8787
# API key de YouTube Data API v3. Solo en el backend; nunca en Vite/React.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_CALL_LIMIT=100
YOUTUBE_CACHE_TTL_MS=21600000
YOUTUBE_CACHE_MAX_ENTRIES=500
# Client Credentials de Spotify: se usan solo en el servidor.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Origen del frontend publicado.
CORS_ORIGIN=http://localhost:5173
